		<key>flonum-vector</key>
		<dict>
			<key>begin</key>
			<string>(#\d*vfl\()</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.flonum-vector.begin.scheme</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(\))</string>
			<key>endCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.flonum-vector.end.scheme</string>
				</dict>
			</dict>
			<key>name</key>
			<string>meta.flonum-vector.scheme</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#comment</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#constants</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#illegal</string>
				</dict>
			</array>
		</dict>
		<key>illegal</key>
		<dict>
			<key>match</key>
			<string>[()]</string>
			<key>name</key>
			<string>invalid.illegal.parenthesis.scheme</string>
		</dict>
		<key>language-functions</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or ( 
						( do|or|and|else|quasiquote|begin|if|case|set!|
						  cond|let|unquote|define|let\*|unquote-splicing|delay|letrec-syntax|
						  letrec|letrec\*|when|unless|guard|dynamic-wind|
						  with-exception-handler|library|import|export|
						  define-record-type|let-values|let\*-values|
						  define-values|call-with-values|parameterize|
						  fluid-let|syntax|quasisyntax|unsyntax|unsyntax-splicing|syntax-case|with-syntax|syntax-rules|
						  define-syntax|identifier-syntax|and-let\*|time|assert|case-lambda|
						  lambda|
						  define-library|include|include-ci|cond-expand|
						  top-level-program|module|import-only|alias|
						  =&gt;|\.\.\.|rename|only|except|prefix|for|meta|rec|record-case|engine-block|engine-return|fluid-let-syntax|
						  eval-when|with-interrupts-disabled|critical-section|
						  datum|define-property|with-implicit|meta-cond|
						  implicit-exports|indirect-export|library-group|extend-syntax|with|
						  define-condition-type|
						  fields|mutable|immutable|opaque|sealed|nongenerative|parent|parent-rtd|protocol|predicate|
						  define-ftype|ftype)
						(?=[\s\(\)\[\]])</string>
					<key>name</key>
					<string>keyword.control.scheme</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>
						These functions run a test, and return a boolean
						answer.
					</string>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or (
						( char-alphabetic|char-lower-case|char-numeric|
						  char-ready|char-upper-case|char-whitespace|
						  (?:char|string)(?:-ci)?(?:=|&lt;=?|&gt;=?)|
						  atom|boolean|bound-identifier=|char|complex|
						  identifier|integer|symbol|free-identifier=|inexact|
						  eof-object|exact|list|(?:input|output)-port|pair|
						  real|rational|zero|vector|negative|odd|null|string|
						  eq|equal|eqv|even|number|positive|procedure|
						  bytevector|hashtable|eq-hashtable|eqv-hashtable|weak-eq-hashtable|weak-eqv-hashtable|
						  record|record-type-descriptor|record-constructor-descriptor|
						  time|date|enum-set|fixnum|flonum|exact-integer|bignum|ratnum|cflonum|
						  finite|infinite|nan|port|input-port|output-port|port-closed|port-eof|port-nonblocking|
						  real-valued|rational-valued|integer-valued|boolean=|close-input-port|close-output-port|
						  binary-port|textual-port|socket|thread|mutex|condition-variable|thread-condition|
						  box|environment|environment-mutable|annotation|source-object|source-file-descriptor|
						  eof-object
						)
						(\?)		# name ends with ? sign
						(?=[\s\(\)\[\]]) # followed by space or (
					</string>
					<key>name</key>
					<string>support.function.boolean-test.scheme</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>
						These functions change one type into another.
					</string>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or (
						( char-&gt;integer|exact-&gt;inexact|inexact-&gt;exact|
						  integer-&gt;char|symbol-&gt;string|list-&gt;vector|
						  list-&gt;string|identifier-&gt;symbol|vector-&gt;list|
						  string-&gt;list|string-&gt;number|string-&gt;symbol|
						  number-&gt;string
						)
						(?=[\s\(\)\[\]]) # followed by space or (					
					</string>
					<key>name</key>
					<string>support.function.convert-type.scheme</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>
						These functions are potentially dangerous because
						they have side-effects which could affect other
						parts of the program.
					</string>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or (
						( set-(?:car|cdr)|				 # set car/cdr
						  (?:vector|string)-(?:fill|set)| # fill/set string/vector
						  hashtable-(?:clear|delete|set|update)|
						  bytevector-(?:fill|copy)
						)
						(!)			# name ends with ! sign
						(?=[\s\(\)\[\]]) # followed by space or (
					</string>
					<key>name</key>
					<string>support.function.with-side-effects.scheme</string>
				</dict>
				<dict>
					<key>comment</key>
					<string>
						+, -, *, /, =, &gt;, etc. 
					</string>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or (
						( &gt;=?|&lt;=?|=|[*/+-])
						(?=(\s|\)|\])) # followed by space or (
						</string>
					<key>name</key>
					<string>keyword.operator.arithmetic.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?x)
						(?&lt;=(\s|\(|\[)) # preceded by space or (
						( append|apply|approximate|
						  call-with-current-continuation|call/cc|call/1cc|catch|
						  construct-identifier|display|
						  for-each|force|format|cd|gen-counter|gen-loser|
						  generate-identifier|last-pair|length|let-syntax|
						  list|list-ref|list-tail|load|log|
						  macro|magnitude|map|map-streams|max|member|memq|
						  memv|min|newline|nil|not|peek-char|rationalize|
						  read|read-char|return|reverse|sequence|substring|
						  syntax-rules|transcript-off|transcript-on|
						  truncate|unwrap-syntax|values-list|write|write-char|
						  
						  # cons, car, cdr, etc
						  cons|c(a|d){1,4}r| 
                          
						  # unary math operators
						  abs|acos|angle|asin|assoc|assq|assv|atan|ceiling|
						  cos|floor|round|sin|sqrt|tan|
						  (?:real|imag)-part|numerator|denominator
                          
						  # other math operators
						  modulo|exp|expt|remainder|quotient|lcm|
                          
						  # ports / files
						  call-with-(?:input|output)-file|
						  (?:close|current)-(?:input|output)-port|
						  with-(?:input|output)-from-file|
						  open-(?:input|output)-file|open-input-output-file|
						  
						  # char-«foo»
						  char-(?:downcase|upcase|ready|foldcase)|
						  
						  # make-«foo»
						  make-(?:polar|promise|rectangular|string|vector)
						  
						  # string-«foo», vector-«foo»
						  string(?:-(?:append|copy|length|ref))?|
						  vector(?:-length|-ref)|
						  
						  # R6RS / modern additions
