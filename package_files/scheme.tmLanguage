		<key>comment</key>
		<dict>
			<key>begin</key>
			<string>(^[ \t]+)?(?=;)</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>punctuation.whitespace.comment.leading.scheme</string>
				</dict>
			</dict>
			<key>end</key>
			<string>(?!\G)</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>begin</key>
					<string>;</string>
					<key>beginCaptures</key>
					<dict>
						<key>0</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.comment.scheme</string>
						</dict>
					</dict>
					<key>end</key>
					<string>\n</string>
					<key>name</key>
					<string>comment.line.semicolon.scheme</string>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>#(?i:[tf]|true|false)</string>
					<key>name</key>
					<string>constant.language.boolean.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?i:#!(?:eof|bwp|true|false|null|r6rs|chezscheme|fold-case|no-fold-case))</string>
					<key>name</key>
					<string>constant.language.directive.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])([+-]inf\.0|[+-]nan\.0)(?=[\s;()'",\[\]])</string>
					<key>name</key>
					<string>constant.numeric.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])([+-]?(?:\d+/\d+|\d+\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+[eEsSfFdDlL][+-]?\d+|\d+\.\d*|\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+)?[+-](?:\d+/\d+|\d+\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+[eEsSfFdDlL][+-]?\d+|\d+\.\d*|\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+)?i|[+-]i)(?=[\s;()'",\[\]])</string>
					<key>name</key>
					<string>constant.numeric.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])(\#\d+[rR][+-]?(?:[0-9a-zA-Z]+\.[0-9a-zA-Z]*|\.[0-9a-zA-Z]+|[0-9a-zA-Z]+))(?=[\s;()'",\[\]])</string>
					<key>name</key>
					<string>constant.numeric.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"',;#])(\#x[+-]?[0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?)(?=[\s;()'",\[\]{}])</string>
					<key>name</key>
					<string>constant.numeric.scheme</string>
				</dict>
					<dict>
						<key>match</key>
						<string>(?&lt;=[\(\[\s{}"\',;#])(\#x[+-]?(?:[0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?|\.[0-9a-fA-F]+)?[+-](?:[0-9a-fA-F]+(?:\.[0-9a-fA-F]*)?|\.[0-9a-fA-F]+)?i|\#x[+-]i)(?=[\s;()"',\[\]{}])</string>
						<key>name</key>
						<string>constant.numeric.scheme</string>
					</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])(?:\#[ei]?\#[boxd]|\#[boxd]\#[ei]?|\#[ei]?|\#[boxd]?)?[+-]?(?:\d+/\d+|\d+\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+[eEsSfFdDlL][+-]?\d+|\d+\.\d*|\.\d+(?:[eEsSfFdDlL][+-]?\d+)?|\d+)(?=[\s;()'",\[\]])</string>
					<key>name</key>
					<string>constant.numeric.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])(#\d+=)</string>
					<key>name</key>
					<string>constant.other.graph-mark.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])(#\d+#)</string>
					<key>name</key>
					<string>constant.other.graph-ref.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"'\,;#])(#&amp;)</string>
					<key>name</key>
					<string>constant.other.box.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"',;#])(#:(?:[A-Za-z0-9!$%&amp;*+./:&lt;=&gt;?@^_~{}|#-]|\\.)+)</string>
					<key>name</key>
					<string>constant.other.gensym.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"',;#])(#\d*%)</string>
					<key>name</key>
					<string>constant.other.primitive.scheme</string>
				</dict>
				<dict>
					<key>match</key>
					<string>(?&lt;=[\(\[\s{}"',;#])(#@)</string>
					<key>name</key>
					<string>constant.language.fasl.scheme</string>
				</dict>
				<dict>
					<key>begin</key>
					<string>(#\{)</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.gensym.begin.scheme</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(\})</string>
					<key>endCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.gensym.end.scheme</string>
						</dict>
					</dict>
					<key>name</key>
					<string>meta.gensym.scheme</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>match</key>
							<string>\|[^\|]*\|</string>
							<key>name</key>
							<string>entity.name.tag.scheme</string>
						</dict>
						<dict>
							<key>match</key>
							<string>(?:[A-Za-z0-9!$%&amp;*+./:&lt;=&gt;?@^_~|#-]|\.)+</string>
							<key>name</key>
							<string>entity.name.tag.scheme</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>begin</key>
					<string>(#\[)</string>
					<key>beginCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.record.begin.scheme</string>
						</dict>
					</dict>
					<key>end</key>
					<string>(\])</string>
					<key>endCaptures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>punctuation.definition.record.end.scheme</string>
						</dict>
					</dict>
					<key>name</key>
					<string>meta.record.scheme</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>include</key>
							<string>#constants</string>
						</dict>
						<dict>
							<key>include</key>
							<string>#string</string>
						</dict>
						<dict>
							<key>match</key>
							<string>\|[^\|]*\|</string>
							<key>name</key>
							<string>entity.name.type.scheme</string>
						</dict>
						<dict>
							<key>match</key>
							<string>(?:[A-Za-z0-9!$%&amp;*+./:&lt;=&gt;?@^_~{}|#-]|\.)+</string>
							<key>name</key>
							<string>entity.name.type.scheme</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<key>fixnum-vector</key>
		<dict>
			<key>begin</key>
			<string>(#\d*vfx\()</string>
			<key>beginCaptures</key>
			<dict>
				<key>1</key>
				<dict>
					<key>name</key>
					<string>punctuation.definition.fixnum-vector.begin.scheme</string>
				</dict>
			</dict>
